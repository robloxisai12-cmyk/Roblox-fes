{
  "$schema": "https://raw.githubusercontent.com/rojo-rbx/rojo/v7.7.0/schemas/project.schema.json",
  "name": "SierraDeGuardia",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$className": "Folder",
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "SquadRequest": {
          "$className": "RemoteFunction"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$className": "Folder",
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$className": "Folder",
          "$path": "src/client"
        }
      }
    }
  }
}